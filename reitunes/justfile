# The following commands ARE relevant for agents

publish:
    op run --env-file="./prod.env" -- cross build --target x86_64-unknown-linux-musl --release
    rsync ../target/x86_64-unknown-linux-musl/release/reitunes spudnik.reillywood.com:bin/
    ssh spudnik.reillywood.com -t "systemctl --user restart reitunes"

get-logs n:
    ssh -q spudnik -t "journalctl --user -u reitunes.service -n {{n}} --no-pager"

# The following commands are NOT for agent use

install-deps:
    cargo install xh --locked

watch:
    watchexec --exts=rs,sql,html,css,js --on-busy-update=restart -- cargo run -- --live-reload

run-with-secrets:
    op run --env-file="./prod.env" -- cargo run

build-with-secrets:
    op run --env-file="./prod.env" -- cargo build


run:
    cargo run

# Development service management (for agents)
pidfile := "/tmp/reitunes-dev.pid"
logfile := "/tmp/reitunes-dev.log"

# Start the backend as a background service
start:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f {{pidfile}} ] && kill -0 $(cat {{pidfile}}) 2>/dev/null; then
        echo "Backend already running (PID: $(cat {{pidfile}}))"
        exit 0
    fi
    cargo build
    nohup ../target/debug/reitunes > {{logfile}} 2>&1 &
    echo $! > {{pidfile}}
    sleep 2
    if kill -0 $(cat {{pidfile}}) 2>/dev/null; then
        echo "Backend started (PID: $(cat {{pidfile}}))"
        tail -5 {{logfile}}
    else
        echo "Failed to start backend"
        cat {{logfile}}
        exit 1
    fi

# Stop the backend service
stop:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f {{pidfile}} ]; then
        PID=$(cat {{pidfile}})
        if kill -0 $PID 2>/dev/null; then
            kill $PID
            echo "Stopped backend (PID: $PID)"
        else
            echo "Backend not running"
        fi
        rm -f {{pidfile}}
    else
        echo "No pidfile found"
    fi

# Restart the backend service
restart: stop start

# Show backend logs
logs n="50":
    tail -n {{n}} {{logfile}}

# Check backend status
status:
    #!/usr/bin/env bash
    if [ -f {{pidfile}} ] && kill -0 $(cat {{pidfile}}) 2>/dev/null; then
        echo "Backend running (PID: $(cat {{pidfile}}))"
    else
        echo "Backend not running"
    fi

test:
    cargo nextest run

watch-tests:
    watchexec --exts=rs,sql,html -- cargo nextest run

expected_filename := if os_family() == "windows" { "reitunes-rs.exe" } else { "reitunes-rs" }

build-release:
    cargo build --release
    @$"Build size: (ls target/release/{{expected_filename}} | get size)"


build-linux-x64:
    cross build --target x86_64-unknown-linux-gnu --release

build-linux-arm64:
    cross build --target aarch64-unknown-linux-gnu --release

build-windows-on-linux:
    cross build --target x86_64-pc-windows-gnu --release
