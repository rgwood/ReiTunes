# Build and deploy to spudnik. Needs prod.env (see prod.env.example).
publish:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f ./prod.env ]]; then echo "ERROR: prod.env not found, refusing to build a secretless binary" >&2; exit 1; fi
    set -a && source ./prod.env && set +a
    if [[ -z "${S3_ENDPOINT:-}" || -z "${REITUNES_PASSWORD:-}" || -z "${REITUNES_API_KEY:-}" ]]; then echo "ERROR: prod.env is missing required values" >&2; exit 1; fi
    if [[ -z "${OPENROUTER_API_KEY:-}" && -f "${OPENROUTER_API_KEY_FILE:-../openrouterkey.txt}" ]]; then export OPENROUTER_API_KEY="$(cat "${OPENROUTER_API_KEY_FILE:-../openrouterkey.txt}")"; fi
    if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then echo "ERROR: set OPENROUTER_API_KEY or OPENROUTER_API_KEY_FILE before publishing, so import metadata and automatic tagging stay enabled" >&2; exit 1; fi
    export TAGGING_CODE_REVISION="$(git describe --always --dirty)"
    cargo build -p reitunes --target x86_64-unknown-linux-musl --release
    rsync ../target/x86_64-unknown-linux-musl/release/reitunes spudnik:bin/
    ssh spudnik -t "systemctl --user restart reitunes"

# Show the last n lines of the production server log
get-logs n:
    ssh -q spudnik -t "journalctl --user -u reitunes.service -n {{n}} --no-pager"

install-deps:
    cargo install xh --locked

# Development: watches Rust files, restarts server on changes. Vite-rs handles frontend HMR.
dev: kill
    #!/usr/bin/env bash
    set -a && source .env && set +a
    watchexec --exts=rs,sql --on-busy-update=restart -- cargo run -- --no-auth

# Kill any running reitunes/watchexec dev processes
kill:
    -pkill -f "watchexec.*reitunes"
    -pkill -f "target/.*reitunes"

test:
    cargo nextest run

watch-tests:
    watchexec --exts=rs,sql,html -- cargo nextest run
