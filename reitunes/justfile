# The following commands ARE relevant for agents

publish:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f ./prod.env ]]; then echo "ERROR: prod.env not found, refusing to build a secretless binary" >&2; exit 1; fi
    set -a && source ./prod.env && set +a
    if [[ -z "${S3_ENDPOINT:-}" || -z "${REITUNES_PASSWORD:-}" ]]; then echo "ERROR: prod.env is missing required values" >&2; exit 1; fi
    cargo build -p reitunes --target x86_64-unknown-linux-musl --release
    rsync ../target/x86_64-unknown-linux-musl/release/reitunes spudnik.reillywood.com:bin/
    ssh spudnik.reillywood.com -t "systemctl --user restart reitunes"

get-logs n:
    ssh -q spudnik -t "journalctl --user -u reitunes.service -n {{n}} --no-pager"

# The following commands are NOT for agent use

install-deps:
    cargo install xh --locked

# Development: watches Rust files, restarts server on changes. Vite-rs handles frontend HMR.
dev: kill
    #!/usr/bin/env bash
    set -a && source .env && set +a
    watchexec --exts=rs,sql --on-busy-update=restart -- cargo run -- --no-auth

# Kill any running reitunes/watchexec dev processes
kill:
    -pkill -f "watchexec.*reitunes"
    -pkill -f "target/.*reitunes"

test:
    cargo nextest run

watch-tests:
    watchexec --exts=rs,sql,html -- cargo nextest run

expected_filename := if os_family() == "windows" { "reitunes-rs.exe" } else { "reitunes-rs" }

build-release:
    cargo build --release
    @$"Build size: (ls target/release/{{expected_filename}} | get size)"


build-linux-x64:
    cross build --target x86_64-unknown-linux-gnu --release

build-linux-arm64:
    cross build --target aarch64-unknown-linux-gnu --release

build-windows-on-linux:
    cross build --target x86_64-pc-windows-gnu --release
